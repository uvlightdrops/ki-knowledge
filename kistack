#!/bin/sh
# Compatibility alias, rooted in this project.
set -e
ROOT=$(dirname "$(readlink -f "$0")")
if [ -x "$ROOT/.venv/bin/python" ]; then
    cd "$ROOT"
    exec "$ROOT/.venv/bin/python" -m stackctl "$@"
elif [ -x "$HOME/.local/bin/stackctl" ]; then
    STACKCTL="$HOME/.local/bin/stackctl"
elif command -v stackctl >/dev/null 2>&1; then
    STACKCTL=$(command -v stackctl)
else
    echo "Zentrales stackctl fehlt: zuerst stackctl/scripts/install-user.sh ausfuehren oder stackctl im PATH bereitstellen." >&2
    exit 127
fi
cd "$ROOT"
exec "$STACKCTL" "$@"
