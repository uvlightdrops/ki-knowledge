# Copy to deploy/stack.env (not in git) and adjust per host.
# Real environment variables override these values; every entry is passed to the services.

# Django UI (runserver). 0.0.0.0 = reachable from the network.
KI_DJANGO_HOST=127.0.0.1
KI_DJANGO_PORT=8000

# FastAPI knowledge API. Django gets KNOWLEDGE_API_URL derived from these.
KI_API_HOST=127.0.0.1
KI_API_PORT=8090
KI_API_RELOAD=true

# Only probed / started via deploy/postgres; keep in sync with the DSN in ki.yaml.
KI_PG_HOST=127.0.0.1
KI_PG_PORT=5432
KI_OLLAMA_URL=http://127.0.0.1:11434

# Install: where ki-core and widgetkit-django live (default: next to this repo), extras like "dev".
#KI_SRC_DIR=/opt/ki
#KI_INSTALL_EXTRAS=dev

# Prod-like host (still runserver): reachable from the LAN, no debug, no autoreload.
#KI_DJANGO_HOST=0.0.0.0
#KI_API_RELOAD=false
#DJANGO_DEBUG=false
#DJANGO_SECRET_KEY=change-me
#DJANGO_ALLOWED_HOSTS=kihost.lan,localhost
#WAGTAILADMIN_BASE_URL=http://kihost.lan:8000
