#!/usr/bin/env python
"""Ki-Knowledge CLI Entry Point Script.

This script provides the main CLI interface for ki-knowledge.
It dynamically loads command hierarchy from cli.yaml configuration.

Example usage:
    ki infosite generate
    ki infosite list
    ki knowledge import
"""

import sys
from pathlib import Path

# Add project root to path
project_root = Path(__file__).parent
sys.path.insert(0, str(project_root))

from ki_knowledge.cli.main import main

if __name__ == "__main__":
    main()
